# open-alive configuration — copy to ~/.open-alive/.env (chmod 600).
# `open-alive setup` writes this file for you. Values already exported in the
# process environment win over the file. Every key is optional.
#
# open-alive 설정 — ~/.open-alive/.env 로 복사해 사용하세요 (권한 600).
# `open-alive setup` 이 이 파일을 대신 만들어 줍니다. 모든 항목은 선택입니다.

# ── Server / 서버 ─────────────────────────────────────────────────────────────
# OPEN_ALIVE_PORT=3141
# OPEN_ALIVE_EVENT_DB=~/.open-alive/alive.db     # event store (SQLite)
# OPEN_ALIVE_TICKET_CONCURRENCY=                 # max tickets running at once
# OPEN_ALIVE_AUTO_COMMIT=1                        # 0 = never git-commit after a passing ticket
# OPEN_ALIVE_AUTO_COLLECT=1                       # 0 = don't run Efficio (python3) on session end
# EFFICIO_PYTHON=python3

# ── LLM gateway (optional) / LLM 게이트웨이 (선택) ─────────────────────────────
# Any OpenAI-compatible endpoint (LiteLLM proxy, vLLM, Ollama's /v1, …).
# Enables sub-agent delegation (`oa-delegate`) and multi-model review panels.
# Without a key, tickets still run — they just don't delegate.
# OpenAI 호환 엔드포인트. 설정하면 서브에이전트 위임과 멀티모델 리뷰가 켜집니다.
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_KEY=
# OA_DELEGATE_MODEL=                              # default model for oa-delegate
# OA_DELEGATE_MODELS_FILE=~/.open-alive/models.json   # model catalogue (see examples/models.example.json)
# OA_DELEGATE_FALLBACKS=                          # comma-separated fallback chain for every model
# OA_DELEGATE_TIMEOUT_MS=180000
# OA_PANEL_MODELS=                                # comma-separated review-panel roster
# OPEN_ALIVE_PANEL_EXCLUDE=                       # colon-separated dirs whose tickets never go to the panel

# ── Remote access (off by default) / 원격 접속 (기본 꺼짐) ─────────────────────
# Read SECURITY.md first. / 먼저 SECURITY.md 를 읽어주세요.
# OPEN_ALIVE_REMOTE=1
# OPEN_ALIVE_HOST=127.0.0.1
# OPEN_ALIVE_TICKET_ROOTS=/path/to/your/work     # required in remote mode (colon-separated)
# OPEN_ALIVE_REMOTE_SSH_HOSTS=
# OPEN_ALIVE_REMOTE_TERMINAL=off                  # off | watch | input | shell
# OPEN_ALIVE_TRUST_LOOPBACK=0
# OPEN_ALIVE_TOKENS=                              # managed by `open-alive token new|revoke`
