{
  "name": "open-alive",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time dashboard and ticket runner for Claude Code sessions, powered by hooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/must-goldenrod/open-alive.git"
  },
  "homepage": "https://github.com/must-goldenrod/open-alive",
  "bugs": {
    "url": "https://github.com/must-goldenrod/open-alive/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "changelog": "bash scripts/changelog.sh",
    "pack:local": "bash scripts/build-npm.sh",
    "repack": "bash scripts/repack-local.sh",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "setup": "bash scripts/install.sh"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "turbo": "^2",
    "typescript": "^5.7",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "better-sqlite3"
    ],
    "overrides": {
      "ws": ">=8.21.0",
      "fast-uri": ">=3.1.4 <4 || >=4.1.3",
      "vitest": "^4.1.11",
      "picomatch": ">=4.0.4",
      "@babel/core": ">=7.29.6",
      "turbo": ">=2.9.14",
      "find-my-way": ">=9.7.0",
      "@vitest/mocker": "^4.1.11",
      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18 <4 || >=5.1.6",
      "undici": ">=7.29.0 <8",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-g7r4-m6w7-qqqr"
      ]
    }
  }
}
